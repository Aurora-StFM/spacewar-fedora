[Unit]
Description=USB networking gadget (Nothing Phone 1)
After=systemd-modules-load.service
Before=network.target sshd.service
Wants=nothing-spacewar-usb-dhcp.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/nothing-spacewar/nothing-spacewar-usb-gadget start
ExecStop=/usr/libexec/nothing-spacewar/nothing-spacewar-usb-gadget stop

[Install]
WantedBy=multi-user.target
