##
## Fedora-specific additions, merged on top of Nura's
## config-postmarketos-qcom-sc7280.aarch64 (overrides.config comes last).
##

## SELinux: Fedora runs SELinux enforcing.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="lockdown,yama,integrity,selinux,bpf,landlock"

## Fedora ships compressed firmware (linux-firmware) and kernel modules.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

## Root filesystem is ext4 in the userdata partition.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=m
CONFIG_EROFS_FS=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m

## zram swap (zram-generator is on by default in Fedora).
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZO=y

## USB networking for SSH during bring-up (nothing-spacewar-usb-gadget).
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

## Sensors and other DSP services go through FastRPC (hexagonrpcd).
CONFIG_QCOM_FASTRPC=m

## Handy for debugging and for tools that read the running config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## The release string is set by the build script.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
