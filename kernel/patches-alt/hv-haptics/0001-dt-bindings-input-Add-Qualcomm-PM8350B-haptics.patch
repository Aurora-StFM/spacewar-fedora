From ebc445f014f3075e0123035ff363d2f3ec149d8f Mon Sep 17 00:00:00 2001
From: Aurora-StFM <scp.173.x@gmail.com>
Date: Mon, 26 Oct 2026 22:17:25 +0100
Subject: [PATCH 1/3] dt-bindings: input: Add Qualcomm PM8350B haptics

Document the high-voltage LRA haptics block found in Qualcomm PMICs such
as PM8350B. It consists of three SPMI peripherals (configuration,
pattern and boost) and drives a linear resonant actuator.

Co-developed-by: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Aurora-StFM <scp.173.x@gmail.com>
---
 .../bindings/input/qcom,pm8350b-haptics.yaml  | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/qcom,pm8350b-haptics.yaml

diff --git a/Documentation/devicetree/bindings/input/qcom,pm8350b-haptics.yaml b/Documentation/devicetree/bindings/input/qcom,pm8350b-haptics.yaml
new file mode 100644
index 000000000..cc2df102e
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/qcom,pm8350b-haptics.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/qcom,pm8350b-haptics.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMIC high-voltage LRA haptics
+
+maintainers:
+  - Aurora-StFM <scp.173.x@gmail.com>
+
+description:
+  Haptics block in Qualcomm PMICs such as PM8350B that drives a linear
+  resonant actuator (LRA) from its own boost converter. It consists of three
+  SPMI peripherals - configuration, pattern and boost - listed in that order
+  in reg.
+
+properties:
+  compatible:
+    const: qcom,pm8350b-haptics
+
+  reg:
+    items:
+      - description: HAPTICS_CFG peripheral
+      - description: HAPTICS_PATTERN peripheral
+      - description: HAPTICS_BOOST peripheral
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: fifo-empty
+
+  qcom,vmax-microvolt:
+    description: Peak drive voltage of the actuator.
+    minimum: 50000
+    maximum: 11000000
+
+  qcom,lra-period-us:
+    description:
+      Resonance period of the actuator, used as the open-loop drive period
+      before auto-resonance locks on.
+    minimum: 5
+    maximum: 20475
+
+required:
+  - compatible
+  - reg
+  - qcom,vmax-microvolt
+  - qcom,lra-period-us
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        haptics@f000 {
+            compatible = "qcom,pm8350b-haptics";
+            reg = <0xf000>, <0xf100>, <0xf200>;
+            interrupts = <0x3 0xf0 0x1 IRQ_TYPE_EDGE_RISING>;
+            interrupt-names = "fifo-empty";
+            qcom,vmax-microvolt = <3600000>;
+            qcom,lra-period-us = <5880>;
+        };
+    };
+...
