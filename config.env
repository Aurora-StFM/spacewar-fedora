# Nothing Phone (1) Fedora kit: pinned versions.
# Change these to move to a newer kernel or Fedora release.
# Values already set in the environment win over the defaults below.

# Fedora release the root filesystem is built from.
: "${FEDORA_RELEASE:=44}"
# Phone shell: "phosh" or "plasma-mobile".
: "${UI:=phosh}"

# Kernel: the Nura port developers' Spacewar branch (Linux 7.3-rc4 plus about
# 70 device patches: microphones and calls, stereo speakers, haptics, Glyph
# LEDs, touchscreen, cameras, Wi-Fi calibration). It is a personal
# development branch that can be rebased; the pinned commit keeps working
# only while GitHub still has it. To keep a copy, fork mainlining/linux on
# GitHub and point KERNEL_REPO at the fork.
: "${KERNEL_REPO:=https://github.com/mainlining/linux.git}"
: "${KERNEL_BRANCH:=fekz115/spacewar}"
: "${KERNEL_COMMIT:=2ee0b2cb4b3410733f0feea2916c8b23ed7f9015}"
# The kernel's own version string (Makefile VERSION.PATCHLEVEL.SUBLEVEL + EXTRAVERSION).
: "${KERNEL_VERSION:=7.3.0-rc4}"
# Bump this when you rebuild the same kernel version with changes.
: "${KERNEL_PKG_RELEASE:=1}"

# Configuration: arm64 defconfig plus the branch's sc7280.config fragment,
# then kernel/fedora.config and kernel/overrides.config on top.
: "${KERNEL_CONFIG_TARGETS:=defconfig sc7280.config}"

# Device firmware (DSPs, modem, GPU zap shader, touch, Wi-Fi board file).
: "${FIRMWARE_REPO:=https://github.com/mainlining/firmware-nothing-spacewar.git}"
: "${FIRMWARE_COMMIT:=cc01a8900344afb8a8e254f7bb607d1b4affeb3c}"

# ALSA UCM profiles for SC7280 devices (same commit Nura uses).
: "${UCM_REPO:=https://github.com/sc7280-mainline/alsa-ucm-conf.git}"
: "${UCM_COMMIT:=3dbb936f0cc85a5d3f12bab12a4578d85768061c}"

# Helper tools Fedora doesn't package: built as aarch64 RPMs with mock.
: "${HEXAGONRPC_REPO:=https://github.com/linux-msm/hexagonrpc.git}"
: "${HEXAGONRPC_VERSION:=0.5.0}"
: "${HEXAGONRPC_COMMIT:=435ed1cd68e20f8a9fe4871233ed1f8ce7ccf9e8}"
: "${QBOOTCTL_REPO:=https://github.com/linux-msm/qbootctl.git}"
: "${QBOOTCTL_VERSION:=0.2.2}"
: "${QBOOTCTL_COMMIT:=39a6e6daaf029fb0a083777679a15ea2c18f72de}"
# Keeps the voice call streams open (Voice Call UCM profile). Same commit and
# SHA-256 as the NixOS Fairphone 5 package (gian-reto/nixos-fairphone-fp5).
: "${DUMMYSTREAMHACK_COMMIT:=f82b9a9f1583bfa44ae32a408318af1e44af3c5e}"
: "${DUMMYSTREAMHACK_VERSION:=0^20260526gitf82b9a9}"
: "${DUMMYSTREAMHACK_URL:=https://codeberg.org/valpackett/dummystreamhack/archive/${DUMMYSTREAMHACK_COMMIT}.tar.gz}"
: "${DUMMYSTREAMHACK_SHA256:=385330235890a3bfed960cf669b8033b26e737c38f5ea32214ad03a2451beb03}"

# Android boot image layout, from Nura's deviceinfo for nothing-spacewar.
: "${BOOTIMG_HEADER_VERSION:=2}"
: "${BOOTIMG_PAGESIZE:=4096}"
: "${BOOTIMG_BASE:=0x00000000}"
: "${BOOTIMG_KERNEL_OFFSET:=0x00008000}"
: "${BOOTIMG_RAMDISK_OFFSET:=0x01000000}"
: "${BOOTIMG_SECOND_OFFSET:=0x00000000}"
: "${BOOTIMG_TAGS_OFFSET:=0x00000100}"
: "${BOOTIMG_DTB_OFFSET:=0x01f00000}"

# Kernel command line. The root filesystem lives in the userdata partition.
: "${KERNEL_CMDLINE:=root=PARTLABEL=userdata rootfstype=ext4 rw rootwait console=tty0}"

# Free space added to the root filesystem image on top of its contents.
# It grows to fill userdata on first boot anyway.
: "${ROOTFS_EXTRA_MB:=1024}"

# Where everything is written.
: "${OUT_DIR:=$PWD/out}"
